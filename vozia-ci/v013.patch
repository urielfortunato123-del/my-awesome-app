+++ VoziaTranslate_v0.1.3/app/src/main/java/com/vozia/translate/Diagnostics.kt	2026-09-18 13:50:11.674595745 +0000
@@ -0,0 +1,109 @@
+package com.vozia.translate
+
+import android.content.Context
+import android.os.Build
+import android.util.Log
+import java.io.PrintWriter
+import java.io.StringWriter
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+object Diagnostics {
+    private const val PREFS = "vozia_diagnostics"
+    private const val KEY_STAGE = "last_stage"
+    private const val KEY_STAGE_TIME = "last_stage_time"
+    private const val KEY_CRASH = "last_crash"
+    private const val KEY_CRASH_TIME = "last_crash_time"
+    private const val KEY_CLEAN_STOP = "clean_stop"
+
+    fun install(context: Context) {
+        val app = context.applicationContext
+        val previous = Thread.getDefaultUncaughtExceptionHandler()
+        if (previous is VoziaCrashHandler) return
+        Thread.setDefaultUncaughtExceptionHandler(VoziaCrashHandler(app, previous))
+    }
+
+    fun mark(context: Context, stage: String) {
+        Log.i("VoziaDiag", stage)
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .putString(KEY_STAGE, stage)
+            .putLong(KEY_STAGE_TIME, System.currentTimeMillis())
+            .putBoolean(KEY_CLEAN_STOP, false)
+            .apply()
+    }
+
+    fun cleanStop(context: Context, stage: String = "stopped_cleanly") {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .putString(KEY_STAGE, stage)
+            .putLong(KEY_STAGE_TIME, System.currentTimeMillis())
+            .putBoolean(KEY_CLEAN_STOP, true)
+            .apply()
+    }
+
+    fun record(context: Context, label: String, error: Throwable) {
+        val sw = StringWriter()
+        error.printStackTrace(PrintWriter(sw))
+        val report = buildString {
+            append(label).append('\n')
+            append(error.javaClass.name).append(": ").append(error.message ?: "sem mensagem").append('\n')
+            append(sw.toString().take(4500))
+        }
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .putString(KEY_CRASH, report)
+            .putLong(KEY_CRASH_TIME, System.currentTimeMillis())
+            .putBoolean(KEY_CLEAN_STOP, false)
+            .apply()
+        Log.e("VoziaDiag", label, error)
+    }
+
+    fun clearCrash(context: Context) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .remove(KEY_CRASH)
+            .remove(KEY_CRASH_TIME)
+            .apply()
+    }
+
+    fun report(context: Context): String {
+        val p = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val stage = p.getString(KEY_STAGE, "nenhuma") ?: "nenhuma"
+        val stageTime = p.getLong(KEY_STAGE_TIME, 0L)
+        val crash = p.getString(KEY_CRASH, null)
+        val crashTime = p.getLong(KEY_CRASH_TIME, 0L)
+        val clean = p.getBoolean(KEY_CLEAN_STOP, true)
+        val fmt = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US)
+        return buildString {
+            append("Vozia 0.1.3 diagnostico\n")
+            append("Aparelho: ").append(Build.MANUFACTURER).append(' ').append(Build.MODEL).append('\n')
+            append("Android: ").append(Build.VERSION.RELEASE).append(" (API ").append(Build.VERSION.SDK_INT).append(")\n")
+            append("Ultima etapa: ").append(stage)
+            if (stageTime > 0) append(" @ ").append(fmt.format(Date(stageTime)))
+            append('\n')
+            append("Encerramento limpo: ").append(clean).append('\n')
+            if (crash != null) {
+                append("Falha capturada")
+                if (crashTime > 0) append(" @ ").append(fmt.format(Date(crashTime)))
+                append(":\n").append(crash)
+            } else {
+                append("Falha Java/Kotlin capturada: nenhuma\n")
+                append("Se o sistema fechou o app mesmo assim, a ultima etapa acima ajuda a localizar falha nativa/Samsung/servico de voz.")
+            }
+        }
+    }
+
+    private class VoziaCrashHandler(
+        private val context: Context,
+        private val previous: Thread.UncaughtExceptionHandler?
+    ) : Thread.UncaughtExceptionHandler {
+        override fun uncaughtException(thread: Thread, throwable: Throwable) {
+            try {
+                record(context, "FATAL thread=${thread.name}", throwable)
+            } catch (_: Throwable) { }
+            previous?.uncaughtException(thread, throwable)
+        }
+    }
+}
